{
 "description": "Read-only: Figma node 3142-3 (agent tab), PlayCanvas Editor scene 2596616 (view only), Notion hub; agent tabs closed.",
 "steps": [
  {
   "tool": "list_pages",
   "args": {},
   "save": "figma-00-pages.txt",
   "capture": {
    "p_figma": "(\\d+): [^\\n]*node-id=3142-3"
   }
  },
  {
