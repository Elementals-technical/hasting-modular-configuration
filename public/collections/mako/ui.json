    "model": {
      "label": "Mako Models",
      "kind": "preset-picker"
    },
    "cabinet-builder": {
      "label": "Mako Cabinet Builder",
      "headerPrefix": null,
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "color": {
      "label": "Color",
      "kind": "fields",
      "sectionIds": ["cabinet-color", "handle-color", "leg-color"]
    },
    "countertop": {
      "label": "Countertop & Basin",
      "kind": "fields",
      "sectionIds": ["countertop-color", "countertop-style", "basin-style", "vessel-color"]
