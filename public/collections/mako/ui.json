      "label": "Faucet Details",
      "kind": "fields",
      "sectionIds": ["faucet-holes-amount"]
    },
    "summary": {
      "label": "Summary",
      "kind": "summary"
    }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetType",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-style": {
      "label": "Cabinet Style",
      "fields": [
        {
          "attributeId": "Drawers",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-color": {
      "label": "Cabinet Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetColor",
          "control": "colors",
          "optionsRef": "CabinetColor"
        }
      ]
    },
    "handle-color": {
      "label": "Handle Color",
      "fields": [
        {
          "attributeId": "HandleColor",
          "control": "colors",
          "optionsRef": "HandleColor"
        }
      ]
    },
    "leg-color": {
      "label": "Leg Color",
      "fields": [
        {
          "attributeId": "LegColor",
          "control": "colors",
          "optionsRef": "LegColor",
          "availabilityRef": "LegColor.determined",
          "toggle": { "label": "Enable Legs, Then Color" }
        }
      ]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CountertopColor",
          "control": "colors",
          "optionsRef": "CountertopColor"
        }
      ]
    },
    "countertop-style": {
      "label": "Countertop Style",
      "fields": [
        {
          "attributeId": "CountertopStyle",
          "control": "options-grid",
          "availabilityRef": "CountertopStyle.allowed"
        }
      ]
    },
    "basin-style": {
      "label": "Basin Style",
      "labelWhenVessel": "Vessel Sink Style",
      "fields": [
        {
          "attributeId": "sinkType",
          "control": "options-grid",
          "availabilityRef": "sinkType.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "vessel-color": {
      "label": "Vessel Color",
      "fields": [
        {
          "attributeId": "VesselColor",
          "control": "colors",
          "optionsRef": "VesselColor",
          "availabilityRef": "Countertop.isVesselStyle"
        }
      ]
    },
    "faucet-holes-amount": {
      "label": "Faucet Holes",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "FaucetHolesAmount",
          "control": "swatches",
          "availabilityRef": "FaucetHolesAmount.allowed"
        }
      ]
    }
  }
