  "steps": {
    "model": {
      "label": "Tricot Models",
      "kind": "preset-picker"
    },
    "cabinet-builder": {
      "label": "Tricot Cabinet Builder",
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "color": {
      "label": "Cabinet Finishes",
      "kind": "fields",
      "sectionIds": ["cabinet-color", "cabinet-pattern", "groove-color"]
    },
    "side-panels": {
      "label": "Accessories",
      "kind": "fields",
      "sectionIds": ["side-panels", "dividers"]
    },
    "countertop": {
      "label": "Countertop & Basin",
      "kind": "fields",
      "sectionIds": ["countertop-color", "thickness", "countertop-style", "basin-style", "vessel-color"]
    },
    "summary": {
      "label": "Summary",
      "kind": "summary"
    }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetType",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-style": {
      "label": "Cabinet Style",
      "fields": [
        {
          "attributeId": "Drawers",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-color": {
      "label": "Cabinet Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetColor",
          "control": "colors",
          "optionsRef": "CabinetColor"
        }
      ]
    },
    "cabinet-pattern": {
      "label": "Cabinet Pattern",
      "fields": [
        {
          "attributeId": "DrawerPanelFluting",
          "control": "options-grid",
          "availabilityRef": "DrawerPanelFluting.available",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "groove-color": {
      "label": "Handle Groove Color",
      "fields": [
        {
          "attributeId": "HandleGrooveColor",
          "control": "colors",
          "optionsRef": "HandleGrooveColor"
        }
      ]
    },
    "side-panels": {
      "label": "Side Panels",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "SidePanels",
          "control": "options-grid",
          "availabilityRef": "SidePanels.available"
        }
      ]
    },
    "dividers": {
      "label": "Drawer Dividers",
      "defaultOpen": false,
      "fields": [
        {
          "attributeId": "DividersOption",
          "control": "swatches",
          "hints": {
            "Customize": "Click the ⊕ button to place a divider column. Select added columns to customize it."
          }
        }
      ]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CountertopColor",
          "control": "colors",
          "optionsRef": "CountertopColor",
          "availabilityRef": "CountertopColor.allowed"
        }
      ]
    },
    "thickness": {
      "label": "Thickness",
      "fields": [
        {
          "attributeId": "Thickness",
          "control": "swatches",
          "availabilityRef": "Thickness.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "countertop-style": {
      "label": "Countertop Style",
      "fields": [
        {
          "attributeId": "CountertopStyle",
          "control": "options-grid",
          "availabilityRef": "CountertopStyle.allowed"
        }
      ]
    },
    "basin-style": {
      "label": "Basin Style",
      "labelWhenVessel": "Vessel Sink Style",
      "fields": [
        {
          "attributeId": "sinkType",
          "control": "options-grid",
          "availabilityRef": "sinkType.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "vessel-color": {
      "label": "Vessel Color",
      "fields": [
        {
          "attributeId": "VesselColor",
          "control": "colors",
          "optionsRef": "VesselColor",
          "availabilityRef": "VesselColor.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    }
  },
  "drawerOrganizers": {
    "panelTitle": "Divider Options",
    "mobileLayout": "M2"
  }
}
