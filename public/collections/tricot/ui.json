      "LV890": "images/basin/Trip.jpg",
      "LV892": "images/basin/Orion.jpg",
      "VA002": "images/basin/Olly_55.jpg",
      "VA005": "images/basin/Rectangular.jpg"
    }
  },
  "flows": {
    "prebuilt": {
      "entryStepId": "model",
      "steps": [
        { "stepId": "model", "path": "/prebuilt/model" },
        { "stepId": "color", "path": "/prebuilt/color" },
        { "stepId": "side-panels", "path": "/prebuilt/side-panels" },
        { "stepId": "countertop", "path": "/prebuilt/countertop" },
        { "stepId": "summary", "path": "/prebuilt/summary" }
      ]
    },
    "custom": {
      "entryStepId": "cabinet-builder",
      "steps": [
        { "stepId": "cabinet-builder", "path": "/custom/cabinet-builder" },
        { "stepId": "color", "path": "/custom/color" },
        { "stepId": "side-panels", "path": "/custom/side-panels" },
        { "stepId": "countertop", "path": "/custom/countertop" },
        { "stepId": "summary", "path": "/custom/summary" }
      ]
    }
  },
  "steps": {
    "model": { "label": "Tricot Models", "kind": "preset-picker" },
    "cabinet-builder": {
      "label": "Tricot Cabinet Builder",
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "color": {
      "label": "Cabinet Finishes",
      "kind": "fields",
      "sectionIds": ["cabinet-color", "cabinet-pattern", "groove-color"]
    },
    "side-panels": { "label": "Accessories", "kind": "fields", "sectionIds": ["side-panels"] },
    "countertop": {
      "label": "Countertop & Basin",
      "kind": "fields",
      "sectionIds": ["countertop-color", "thickness", "basin-style"]
    },
    "summary": { "label": "Summary", "kind": "summary" }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [{ "attributeId": "CabinetType", "control": "options-grid" }]
    },
    "cabinet-style": { "label": "Cabinet Style", "fields": [{ "attributeId": "Drawers", "control": "options-grid" }] },
    "cabinet-color": {
      "label": "Cabinet Color",
      "defaultOpen": true,
      "fields": [{ "attributeId": "CabinetColor", "control": "colors", "optionsRef": "CabinetColor" }]
    },
    "cabinet-pattern": {
      "label": "Cabinet Pattern",
      "fields": [
        {
          "attributeId": "DrawerPanelFluting",
          "control": "options-grid",
          "availabilityRef": "DrawerPanelFluting.available",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "groove-color": {
      "label": "Handle Groove Color",
      "fields": [{ "attributeId": "HandleGrooveColor", "control": "colors", "optionsRef": "HandleGrooveColor" }]
    },
    "side-panels": {
      "label": "Side Panels",
      "defaultOpen": true,
      "fields": [{ "attributeId": "SidePanels", "control": "swatches" }]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [{ "attributeId": "CountertopColor", "control": "colors", "optionsRef": "CountertopColor" }]
    },
    "thickness": {
      "label": "Thickness",
      "fields": [
        {
          "attributeId": "Thickness",
          "control": "swatches",
          "availabilityRef": "Thickness.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "basin-style": {
      "label": "Basin Style",
      "fields": [
        {
          "attributeId": "sinkType",
          "control": "options-grid",
          "availabilityRef": "sinkType.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    }
  }
}
