  "steps": {
    "model": {
      "label": "Urban Low Height Models",
      "kind": "preset-picker"
    },
    "cabinet-builder": {
      "label": "Urban Low Height Cabinet Builder",
      "headerPrefix": null,
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "color": {
      "label": "Color",
      "kind": "fields",
      "sectionIds": ["cabinet-color", "drawer-panel"]
    },
    "countertop": {
      "label": "Countertop & Basin",
      "kind": "fields",
      "sectionIds": ["countertop-color", "countertop-style", "basin-style", "vessel-color"]
    },
    "summary": {
      "label": "Summary",
      "kind": "summary"
    }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetType",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-style": {
      "label": "Cabinet Style",
      "fields": [
        {
          "attributeId": "Drawers",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-color": {
      "label": "Cabinet Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetColor",
          "control": "colors",
          "optionsRef": "CabinetColor"
        }
      ]
    },
    "drawer-panel": {
      "label": "Drawer Panel Fluting",
      "fields": [
        {
          "attributeId": "DrawerPanelFluting",
          "control": "options-grid",
          "availabilityRef": "DrawerPanelFluting.available"
        }
      ]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CountertopColor",
          "control": "colors",
          "optionsRef": "CountertopColor"
        }
      ]
    },
    "countertop-style": {
      "label": "Countertop Style",
      "fields": [
        {
          "attributeId": "CountertopStyle",
          "control": "options-grid"
        }
      ]
    },
    "basin-style": {
      "label": "Basin style",
      "labelWhenVessel": "Vessel Sink Style",
      "fields": [
        {
          "attributeId": "sinkType",
          "control": "options-grid",
          "availabilityRef": "sinkType.allowed"
        }
      ]
    },
    "vessel-color": {
      "label": "Vessel Color",
      "fields": [
        {
          "attributeId": "VesselColor",
          "control": "colors",
          "optionsRef": "VesselColor",
          "availabilityRef": "Countertop.isVesselStyle"
        }
      ]
    }
  }
