{
  "collectionId": "urban-low-height",
  "flows": {
    "prebuilt": {
      "entryStepId": "model",
      "steps": [
        {
          "stepId": "model",
          "path": "/prebuilt/model"
        },
        {
          "stepId": "color",
          "path": "/prebuilt/color"
        },
        {
          "stepId": "countertop",
          "path": "/prebuilt/countertop"
        },
        {
          "stepId": "summary",
          "path": "/prebuilt/summary"
        }
      ]
    },
    "custom": {
      "entryStepId": "cabinet-builder",
      "steps": [
        {
          "stepId": "cabinet-builder",
          "path": "/custom/cabinet-builder"
        },
        {
          "stepId": "color",
          "path": "/custom/color"
        },
        {
          "stepId": "countertop",
          "path": "/custom/countertop"
        },
        {
          "stepId": "summary",
          "path": "/custom/summary"
        }
      ]
    }
  },
  "steps": {
    "model": {
      "label": "Urban Low Height Models",
      "kind": "preset-picker"
    },
    "cabinet-builder": {
      "label": "Urban Low Height Cabinet Builder",
      "headerPrefix": null,
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "color": {
      "label": "Color",
      "kind": "fields",
      "sectionIds": ["cabinet-color", "drawer-panel"]
    },
    "countertop": {
      "label": "Countertop",
      "kind": "fields",
      "sectionIds": ["countertop-color"]
    },
    "summary": {
      "label": "Summary",
      "kind": "summary"
    }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetType",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-style": {
      "label": "Cabinet Style",
      "fields": [
        {
          "attributeId": "Drawers",
          "control": "options-grid"
        }
      ]
    },
    "cabinet-color": {
      "label": "Cabinet Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CabinetColor",
          "control": "swatches",
          "optionsRef": "CabinetColor"
        }
      ]
    },
    "drawer-panel": {
      "label": "Drawer Panel Fluting",
      "fields": [
        {
          "attributeId": "DrawerPanelFluting",
          "control": "options-grid",
          "availabilityRef": "DrawerPanelFluting.available"
        }
      ]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CountertopColor",
          "control": "swatches",
          "optionsRef": "CountertopColor"
        }
      ]
    }
  }
}
