{
  "collectionId": "urban-duplex",
  "flows": {
    "prebuilt": {
      "entryStepId": "model",
      "steps": [
        { "stepId": "model", "path": "/prebuilt/model" },
        { "stepId": "cabinet", "path": "/prebuilt/color" },
        { "stepId": "countertop", "path": "/prebuilt/countertop" },
        { "stepId": "accessories", "path": "/prebuilt/accessories", "screen": "accessories" },
        { "stepId": "faucet-holes", "path": "/prebuilt/faucet-holes" },
        { "stepId": "summary", "path": "/prebuilt/summary" }
      ]
    },
    "custom": {
      "entryStepId": "cabinet-builder",
      "steps": [
        { "stepId": "cabinet-builder", "path": "/custom/cabinet-builder" },
        { "stepId": "cabinet", "path": "/custom/color" },
        { "stepId": "countertop", "path": "/custom/countertop" },
        { "stepId": "accessories", "path": "/custom/accessories", "screen": "accessories" },
        { "stepId": "faucet-holes", "path": "/custom/faucet-holes" },
        { "stepId": "summary", "path": "/custom/summary" }
      ]
    }
  },
  "steps": {
    "model": { "label": "Model", "kind": "preset-picker" },
    "cabinet-builder": {
      "label": "Cabinet Builder",
      "headerPrefix": null,
      "kind": "cabinet-builder",
      "sectionIds": ["cabinet-type", "cabinet-style"]
    },
    "cabinet": {
      "label": "Color",
      "kind": "fields",
      "sectionIds": ["panel-color", "lateral-panel-side"]
    },
    "countertop": {
      "label": "Countertop & Basin",
      "kind": "fields",
      "sectionIds": ["countertop-color", "thickness", "countertop-style", "basin-style", "vessel-color"]
    },
    "accessories": { "label": "Accessories", "kind": "fields", "sectionIds": ["towel-bar"] },
    "faucet-holes": { "label": "Faucet Details", "kind": "fields", "sectionIds": ["faucet-holes-amount"] },
    "summary": { "label": "Summary", "kind": "summary" }
  },
  "sections": {
    "cabinet-type": {
      "label": "Cabinet Type",
      "defaultOpen": true,
      "fields": [{ "attributeId": "CabinetType", "control": "options-grid" }]
    },
    "cabinet-style": {
      "label": "Cabinet Style",
      "fields": [{ "attributeId": "Drawers", "control": "options-grid" }]
    },
    "panel-color": {
      "label": "Panel Color",
      "defaultOpen": true,
      "fieldTabs": { "label": "Select Panel, Then Color" },
      "fields": [
        {
          "attributeId": "BasePanelColor",
          "control": "colors",
          "optionsRef": "BasePanelColor",
          "tab": { "label": "Base Panel", "icon": "images/panel/base-panel.svg" }
        },
        {
          "attributeId": "LateralPanelColor",
          "control": "colors",
          "optionsRef": "LateralPanelColor",
          "tab": { "label": "Lateral Panel", "icon": "images/panel/lateral-panel.svg" }
        }
      ]
    },
    "lateral-panel-side": {
      "label": "Lateral Panel",
      "fields": [{ "attributeId": "LateralPanelSide", "control": "options-grid" }]
    },
    "countertop-color": {
      "label": "Countertop Color",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "CountertopColor",
          "control": "colors",
          "optionsRef": "CountertopColor",
          "availabilityRef": "CountertopColor.allowed"
        }
      ]
    },
    "thickness": {
      "label": "Thickness",
      "fields": [
        {
          "attributeId": "Thickness",
          "control": "swatches",
          "availabilityRef": "Thickness.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "countertop-style": {
      "label": "Countertop Style",
      "fields": [
        { "attributeId": "CountertopStyle", "control": "options-grid", "availabilityRef": "CountertopStyle.allowed" }
      ]
    },
    "basin-style": {
      "label": "Basin Style",
      "labelWhenVessel": "Vessel Sink Style",
      "fields": [
        {
          "attributeId": "sinkType",
          "control": "options-grid",
          "availabilityRef": "sinkType.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "vessel-color": {
      "label": "Vessel Color",
      "fields": [
        {
          "attributeId": "VesselColor",
          "control": "colors",
          "optionsRef": "VesselColor",
          "availabilityRef": "VesselColor.allowed",
          "autoSelect": "firstAllowed"
        }
      ]
    },
    "towel-bar": {
      "label": "Towel Bar",
      "defaultOpen": true,
      "fields": [
        { "attributeId": "TowelBarOption", "control": "swatches" },
        { "attributeId": "TowelBarColor", "control": "options-grid", "availabilityRef": "TowelBarColor.available" }
      ]
    },
    "faucet-holes-amount": {
      "label": "Faucet Holes",
      "defaultOpen": true,
      "fields": [
        {
          "attributeId": "FaucetHolesAmount",
          "control": "swatches",
          "availabilityRef": "FaucetHolesAmount.allowed",
          "hints": {
            "1": "Faucet hole placement to be specified at time of order.",
            "2": "Faucet hole placement and spacing to be specified at time of order.",
            "3": "Faucet hole placement and spacing to be specified at time of order."
          }
        }
      ]
    }
  },
  "optionImages": {
    "CabinetType": {
      "Sink-Base": "images/cabinet/sink-base-56.png",
      "Sink-Cabinet": "images/cabinet/side-cabinet-56.png",
      "Open-Shelf": "images/cabinet/open-shelf.png",
      "Side-Shelf": "images/cabinet/open-side-shelf.png"
    },
    "Drawers": {
      "2": "images/cabinet-style/2-drawer.png",
      "1": "images/cabinet-style/1-drawer.png",
      "1+inner": "images/cabinet-style/1-drawer.png"
    },
    "Handle": {
      "UG": "images/handle/UpperGHandle.png"
    },
    "sinkType": {
      "Top_Tekorlux_Rectangular": "images/basin/Rectangular.jpg",
      "Top_HPL/Fenix_Strip_Gres": "images/basin/fenix_Strip.jpg",
      "Top_HPL/Fenix_Cover_Gres": "images/basin/fenix_Cover.jpg",
      "Top_HPL/Fenix_Prisma_Gres": "images/basin/fenix_Prisma.jpg",
      "Top_HPL/Fenix_Quadra_Gres": "images/basin/fenix_Quadra.jpg",
      "Top_HPLStrip": "images/basin/strip.jpg",
      "Top_HPLCover": "images/basin/cover.jpg",
      "Top_HPLPrisma": "images/basin/prisma.jpg",
      "Top_HPLQuadra": "images/basin/quadro.jpg",
      "Top_Porcelain_Strip": "images/basin/strip.jpg",
      "Top_Porcelain_Cover": "images/basin/cover.jpg",
      "Top_Porcelain_Prisma": "images/basin/prisma.jpg",
      "Top_Porcelain_Quadra": "images/basin/quadro.jpg"
    }
  },
  "optionImageVariants": {
    "CabinetType": [
      { "value": "Sink-Base", "when": { "Height": "53" }, "image": "images/cabinet/sink-base-53.png" },
      { "value": "Sink-Base", "when": { "Height": "38" }, "image": "images/cabinet/sink-base-38.png" },
      { "value": "Sink-Base", "when": { "Height": "28" }, "image": "images/cabinet/sink-base-28.png" },
      { "value": "Sink-Cabinet", "when": { "Height": "53" }, "image": "images/cabinet/side-cabinet-53.png" },
      { "value": "Sink-Cabinet", "when": { "Height": "38" }, "image": "images/cabinet/side-cabinet-38.png" },
      { "value": "Sink-Cabinet", "when": { "Height": "28" }, "image": "images/cabinet/side-cabinet-28.png" }
    ],
    "Drawers": [
      { "value": "2", "when": { "Series": "URSTD" }, "image": "images/cabinet-style/urban-standard-2-drawer.png" },
      { "value": "1", "when": { "Series": "URSTD" }, "image": "images/cabinet-style/urban-standard-1-drawer.png" },
      {
        "value": "1+inner",
        "when": { "Series": "URSTD" },
        "image": "images/cabinet-style/urban-standard-1-drawer.png"
      },
      { "value": "1", "when": { "Series": "URLH" }, "image": "images/cabinet-style/urban-low-height-1-drawer.png" }
    ]
  },
  "styleSidebar": {
    "fields": ["Width", "Depth", "Height", "Handle"],
    "attributes": [{ "attributeId": "LateralPanelSide", "when": { "Series": "URDPX" } }]
  },
  "playerMenu": {
    "resize": ["Width", "Depth", "Height"],
    "attributes": [{ "attributeId": "LateralPanelSide", "when": { "Series": "URDPX" } }]
  }
}
