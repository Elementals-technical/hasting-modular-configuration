{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hastings/drawer-organizers.v1.json",
  "title": "productConfig.DrawerOrganizers (v1)",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "Top": { "$ref": "#/$defs/set" },
    "Bot": { "$ref": "#/$defs/set" }
  },
  "$defs": {
    "set": {
      "type": "object", "required": ["style", "columns"], "additionalProperties": false,
      "properties": {
        "style": { "enum": ["Metal", "Oak"] },
        "columns": { "type": "array", "minItems": 1, "maxItems": 11, "items": { "$ref": "#/$defs/column" } }
      }
    },
    "column": {
      "type": "object", "required": ["slot", "positions"], "additionalProperties": false,
      "properties": {
        "slot": { "type": "integer", "minimum": -5, "maximum": 5 },
        "positions": { "type": "array", "uniqueItems": true, "maxItems": 5,
                       "items": { "type": "integer", "minimum": 1, "maximum": 5 } }
      }
    }
  }
}
